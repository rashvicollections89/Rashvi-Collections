# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_CLOUD_API_TOKEN: Meta WhatsApp Business Cloud API Access Token
WHATSAPP_CLOUD_API_TOKEN=""

# WHATSAPP_PHONE_NUMBER_ID: Meta WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=""

# SUPABASE_PROJECT_ID: Supabase project ID (e.g. wnxfyhkmcscpnpfptciv)
SUPABASE_PROJECT_ID=""

# SUPABASE_URL: Supabase Project URL
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Supabase Publishable / Anon API Key
SUPABASE_ANON_KEY=""

