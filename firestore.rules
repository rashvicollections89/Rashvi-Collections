rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rashvicollections@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection test document for startup verification
    match /test/{testId} {
      allow read: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow write: if isValidId(productId);
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow write: if isValidId(categoryId) && isAdmin();
    }

    // Store settings (UPI details, store contacts)
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId) && isAdmin();
    }

    // Marketing & Promotional Media (Ads, Posters, Videos)
    match /marketing_media/{mediaId} {
      allow read: if isValidId(mediaId);
      allow write: if isValidId(mediaId) && isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      // Creation allowed by checkout customers
      allow create: if isValidId(orderId) &&
        incoming().total is number &&
        incoming().total > 0 &&
        incoming().items is list &&
        incoming().items.size() > 0 &&
        incoming().items.size() <= 50;

      // Single order lookup (admin, or customer matching order email/id)
      allow get: if isValidId(orderId);

      // Listing all orders restricted to authenticated admin
      allow list: if isAdmin();

      // Updates: Admin has full rights; Customers can only submit UTR reference
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['utr', 'paymentStatus', 'updatedAt']) &&
          existing().paymentStatus != 'paid' &&
          incoming().utr is string &&
          incoming().utr.size() <= 128
        )
      );

      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
